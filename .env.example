# Belmore Estates: environment variables.
#
# Copy to `.env` for local work (`cp .env.example .env`). .env is gitignored;
# never commit it. On Netlify, set these under Site configuration →
# Environment variables (scope: Functions + Builds) instead of using a file.
# Nothing in this file is a real secret.

# ---------------------------------------------------------------------------
# Database (Neon Postgres)
# ---------------------------------------------------------------------------
# Neon pooled connection string (the host has "-pooler" in it). Used by the
# site's functions and by `npm run db:migrate` / `db:seed` / `db:backup`.
# Leave blank locally to use the in-memory PGLite database (resets on restart).
DATABASE_URL=
# Local only: "1" lets a production build (`npm run build && npm run preview`)
# use PGLite when DATABASE_URL is empty. Never set this on Netlify.
BELMORE_LOCAL_PGLITE=

# ---------------------------------------------------------------------------
# Sign-in (Better Auth + Google OAuth). Only verified Google emails on the
# admins list can sign in. Email/password is off.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32+ random characters: `openssl rand -base64 32`. Changing it signs everyone out.
BETTER_AUTH_SECRET=
# The site's own origin. deploy:preview / deploy:prod set this per deploy, so
# on Netlify you normally leave it unset. Local dev: http://localhost:8080
BETTER_AUTH_URL=
# Extra allowed origins, comma-separated. Default (when blank):
# https://belmore-estates.netlify.app,https://preview--belmore-estates.netlify.app
# Add the custom domain here once it is live (keep the two netlify.app URLs).
BETTER_AUTH_TRUSTED_ORIGINS=

# Owner admins: always allowed in, can't be removed or demoted. Comma-separated.
# Default: belmoreestates@gmail.com,realtor.deleguardia@gmail.com
OWNER_EMAILS=

# ---------------------------------------------------------------------------
# Lead notifications (Web3Forms)
# ---------------------------------------------------------------------------
# One Web3Forms access key per inbox, comma-separated (e.g. one key for
# belmoreestates@gmail.com and one for realtor.deleguardia@gmail.com). Each lead
# is sent once per key, in parallel. Leads are always stored in the database
# first; a failed send shows as "failed"/"partial" in /admin → Leads.
# Blank = no emails, and /admin shows "Notifications not configured".
WEB3FORMS_ACCESS_KEYS=
# Legacy single key (merged with the list above). Prefer WEB3FORMS_ACCESS_KEYS.
WEB3FORMS_ACCESS_KEY=
# "server" (default): the Netlify function calls Web3Forms. Web3Forms' FREE
# plan rejects server-side calls (HTTP 403); server mode needs a paid plan with
# the server IP safelisted. "client": the visitor's browser sends one
# submission per key and reports the result back (works on the free plan;
# the keys are then visible to the browser, which Web3Forms says is fine).
WEB3FORMS_MODE=server

# Public contact address. Fills the {{CONTACT_EMAIL}} token in the site copy.
# Default: belmoreestates@gmail.com
CONTACT_EMAIL=

# ---------------------------------------------------------------------------
# Environment / indexing
# ---------------------------------------------------------------------------
# Only "production" allows search engines. Anything else (including blank, the
# default) sends noindex. deploy:preview sets "preview"; deploy:prod sets
# "production". Don't set this on the Netlify site itself.
SITE_ENV=

# Optional spam check. Only used if TURNSTILE_ENABLED is turned on in
# src/data/site-config.ts (it is off).
TURNSTILE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Local development only (ignored in production builds)
# ---------------------------------------------------------------------------
# "false" hides Google sign-in so you can use the simulated sign-in below.
VITE_AUTH_ENABLED=
# With VITE_AUTH_ENABLED=false and no Google keys: act as this verified email
# in /admin (e.g. belmoreestates@gmail.com). Compiled out of production builds.
BELMORE_QA_AS=
# Point server-side Web3Forms calls at a local mock (dev server only).
WEB3FORMS_API_URL=

# ---------------------------------------------------------------------------
# Deploying (your machine only; never put these on Netlify)
# ---------------------------------------------------------------------------
# Netlify personal access token (User settings → Applications → Personal
# access tokens). Required by npm run deploy:preview / deploy:prod.
NETLIFY_AUTH_TOKEN=
# Site name or ID. Default: belmore-estates
NETLIFY_SITE=
# Default: https://preview--belmore-estates.netlify.app
PREVIEW_URL=
# Default: https://belmore-estates.netlify.app (set to the custom domain later)
PRODUCTION_URL=
# deploy:prod refuses to run unless this is "yes". Set it only for the one
# command, and only after Joseph approves:  BELMORE_PROD_APPROVED=yes npm run deploy:prod
BELMORE_PROD_APPROVED=
# "1" prints the netlify command without running it.
DRY_RUN=

# GitHub Actions secret (not an env var here): BACKUP_DATABASE_URL, the Neon
# connection string the optional nightly backup workflow uses.
